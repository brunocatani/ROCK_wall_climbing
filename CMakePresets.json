{
  "version": 3,
  "configurePresets": [
    {
      "name": "cmake-dev",
      "hidden": true,
      "binaryDir": "${sourceDir}/build",
      "warnings": {
        "dev": true,
        "deprecated": true
      },
      "errors": {
        "deprecated": true
      }
    },
    {
      "name": "vcpkg",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake"
      },
      "environment": {
        "VCPKG_ROOT": "C:/vcpkg"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static"
      }
    },
    {
      "name": "vs2022",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "toolset": "v143",
      "architecture": {
        "value": "x64"
      },
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "/EHsc /MP /W4 /external:anglebrackets /external:W0 $penv{CXXFLAGS}"
      }
    },
    {
      "name": "fast",
      "inherits": ["cmake-dev", "vcpkg", "windows", "vs2022"],
      "binaryDir": "${sourceDir}/build-fast",
      "cacheVariables": {
        "BUILD_ROCK_WALL_CLIMBING_TESTS": false,
        "POST_BUILD_COPY_PLUGIN": false
      }
    },
    {
      "name": "tests",
      "inherits": ["cmake-dev", "vcpkg", "windows", "vs2022"],
      "binaryDir": "${sourceDir}/build-tests",
      "cacheVariables": {
        "BUILD_ROCK_WALL_CLIMBING_TESTS": true,
        "POST_BUILD_COPY_PLUGIN": false
      }
    }
  ]
}
